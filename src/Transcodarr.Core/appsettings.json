{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Transcodarr.Core.Services.MediaFiles": "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "LibraryWatcher": {
    "ScanIntervalSeconds": 30
  },
  "JobQueue": {
    "PollingIntervalSeconds": 30
  },
  "ConnectionStrings": {
    "TranscodarrDb": "Data Source=./Db/transcodarr.db;"
  }
}
